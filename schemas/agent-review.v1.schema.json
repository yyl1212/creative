{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creative 外部单候选模型审查 v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "creative.agent-review.v1"
    },
    "provider": {
      "enum": [
        "openai",
        "deepseek"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reasoning": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "deduplication": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "catalog_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "verdict": {
      "enum": [
        "approved",
        "needs_evidence",
        "rejected"
      ]
    },
    "self_service": {
      "type": "boolean"
    },
    "distinct_from_existing": {
      "type": "boolean"
    },
    "candidate": {
      "$ref": "demand-batch.v1.schema.json#/properties/candidates/items"
    },
    "evidence": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "$ref": "demand-batch.v1.schema.json#/properties/candidates/items/properties/evidence/items/properties/evidence_id"
          },
          "user_key": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 512
          },
          "relevant": {
            "type": "boolean"
          },
          "original": {
            "type": "boolean"
          },
          "direct_user": {
            "type": "boolean"
          },
          "unmet_quote": {
            "type": "string",
            "maxLength": 12000
          },
          "payment_quote": {
            "type": "string",
            "maxLength": 12000
          },
          "price_quote": {
            "type": "string",
            "maxLength": 12000
          },
          "spend_quote": {
            "type": "string",
            "maxLength": 12000
          },
          "conditions_supported": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "repeat_quote": {
            "type": "string",
            "minLength": 0,
            "maxLength": 12000
          }
        },
        "required": [
          "evidence_id",
          "user_key",
          "relevant",
          "original",
          "direct_user",
          "unmet_quote",
          "payment_quote",
          "price_quote",
          "spend_quote",
          "conditions_supported",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "rules_version": {
      "enum": [
        "strong-wtp.v1",
        "opportunity.v2"
      ]
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation"
    }
  },
  "required": [
    "schema_version",
    "provider",
    "model",
    "reviewed_at",
    "reasoning",
    "deduplication",
    "catalog_revision",
    "task_key",
    "verdict",
    "self_service",
    "distinct_from_existing",
    "candidate",
    "evidence",
    "rules_version"
  ],
  "additionalProperties": false,
  "$defs": {
    "evaluation": {
      "type": "object",
      "properties": {
        "depth": {
          "type": "object",
          "properties": {
            "context_complete": {
              "type": "boolean"
            },
            "counterevidence_checked": {
              "type": "boolean"
            },
            "alternatives_checked": {
              "type": "boolean"
            },
            "notes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000,
              "pattern": "\\S"
            }
          },
          "required": [
            "context_complete",
            "counterevidence_checked",
            "alternatives_checked",
            "notes"
          ],
          "additionalProperties": false
        },
        "differentiation": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000,
              "pattern": "\\S"
            },
            "gap_evidence_ids": {
              "type": "array",
              "minItems": 0,
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "fewer_alternatives_reason": {
              "type": "string",
              "minLength": 0,
              "maxLength": 8000
            }
          },
          "required": [
            "summary",
            "gap_evidence_ids",
            "fewer_alternatives_reason"
          ],
          "additionalProperties": false
        },
        "feasibility": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "plausible",
                "validated",
                "blocked",
                "unknown"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000,
              "pattern": "\\S"
            },
            "risks": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              }
            },
            "validation_plan": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000,
              "pattern": "\\S"
            }
          },
          "required": [
            "status",
            "basis",
            "risks",
            "validation_plan"
          ],
          "additionalProperties": false
        },
        "acquisition": {
          "type": "object",
          "properties": {
            "channel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            },
            "evidence_ids": {
              "type": "array",
              "minItems": 0,
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000,
              "pattern": "\\S"
            }
          },
          "required": [
            "channel",
            "evidence_ids",
            "rationale"
          ],
          "additionalProperties": false
        },
        "economics": {
          "type": "object",
          "properties": {
            "cost_basis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000,
              "pattern": "\\S"
            },
            "revenue_hypothesis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000,
              "pattern": "\\S"
            },
            "validation_plan": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000,
              "pattern": "\\S"
            }
          },
          "required": [
            "cost_basis",
            "revenue_hypothesis",
            "validation_plan"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "depth",
        "differentiation",
        "feasibility",
        "acquisition",
        "economics"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "rules_version": {
            "const": "opportunity.v2"
          }
        }
      },
      "then": {
        "required": [
          "evaluation"
        ],
        "properties": {
          "candidate": {
            "properties": {
              "evidence": {
                "items": {
                  "required": [
                    "discussion_url"
                  ]
                }
              }
            }
          },
          "evidence": {
            "items": {
              "required": [
                "repeat_quote"
              ]
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "evaluation"
          ]
        },
        "properties": {
          "evidence": {
            "items": {
              "not": {
                "required": [
                  "repeat_quote"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
