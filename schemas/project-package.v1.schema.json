{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creative 外部模型立项包 v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "creative.project-package.v1"
    },
    "rules_version": {
      "$ref": "demand-batch.v1.schema.json#/properties/rules_version"
    },
    "task_id": {
      "$ref": "demand-batch.v1.schema.json#/properties/task_id"
    },
    "batch_id": {
      "$ref": "demand-batch.v1.schema.json#/properties/batch_id"
    },
    "run_id": {
      "$ref": "demand-batch.v1.schema.json#/properties/run_id"
    },
    "submitted_at": {
      "$ref": "demand-batch.v1.schema.json#/properties/submitted_at"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "demand-batch.v1.schema.json#/properties/candidates/items"
      }
    },
    "run_report": {
      "$ref": "demand-batch.v1.schema.json#/properties/run_report"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "const": "approved"
        },
        "provider": {
          "enum": [
            "openai",
            "deepseek"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "catalog_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "task_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "reasoning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "deduplication": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "valid": {
                "type": "boolean"
              },
              "payment": {
                "type": "boolean"
              },
              "priced": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              }
            },
            "required": [
              "evidence_id",
              "valid",
              "payment",
              "priced",
              "reason"
            ]
          }
        },
        "approval": {
          "type": "object"
        },
        "replaces": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "need_id": {
              "type": "integer",
              "minimum": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "need_id",
            "version"
          ],
          "additionalProperties": false
        },
        "evaluation": {
          "$ref": "agent-review.v1.schema.json#/$defs/evaluation"
        },
        "qualification_valid_until": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "verdict",
        "provider",
        "model",
        "reviewed_at",
        "catalog_revision",
        "task_key",
        "reasoning",
        "deduplication",
        "evidence",
        "approval"
      ]
    }
  },
  "required": [
    "schema_version",
    "rules_version",
    "task_id",
    "batch_id",
    "run_id",
    "submitted_at",
    "candidates",
    "run_report",
    "project"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "rules_version": {
            "const": "opportunity.v2"
          }
        }
      },
      "then": {
        "properties": {
          "project": {
            "required": [
              "evaluation",
              "qualification_valid_until"
            ]
          },
          "candidates": {
            "items": {
              "properties": {
                "evidence": {
                  "items": {
                    "required": [
                      "discussion_url"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "project": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "evaluation"
                  ]
                },
                {
                  "required": [
                    "qualification_valid_until"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ]
}
