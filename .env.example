# 公开站构建配置；这三个字段会出现在公开产物中。
SITE_URL=http://localhost:4321
# ADMIN_URL=http://localhost:8080/admin/login
# FEEDBACK_EMAIL=

# Go 后台私有配置；程序不自动加载 .env 文件，请使用私有进程环境。
CREATIVE_DB=data/creative.db
CREATIVE_ADMIN_ORIGIN=http://localhost:8080
# 默认关闭机器接口；启用时使用与管理入口不同的 Host。
# CREATIVE_RESEARCH_ORIGIN=http://127.0.0.1:8080
CREATIVE_LISTEN=127.0.0.1:8080
CREATIVE_PRODUCTS=src/data/products.json
# 64 位随机十六进制值，不能使用示例/默认密钥。
CREATIVE_CSRF_KEY=
# 仅在实际使用可信代理时指定其 socket 来源 IP；空值忽略转发头。
CREATIVE_TRUSTED_PROXY=
