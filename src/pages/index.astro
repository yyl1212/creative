    <p class="eyebrow">WELCOME TO CREATIVE</p>
    <h1>选择你的语言</h1>
    <p lang="en" class="lead">Choose your language to continue.</p>
    <div class="language-options"><a href="/zh/" lang="zh"><span><strong>简体中文</strong><small lang="en">Chinese</small></span><span aria-hidden="true">→</span></a><a href="/en/" lang="en"><span><strong>English</strong><small lang="zh">英语</small></span><span aria-hidden="true">→</span></a></div>
  </section>
</Base>
