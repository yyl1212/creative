---
import Base from '../../layouts/Base.astro';
import { locales, copy, type Locale } from '../../lib/i18n';
import { readPublicConfig } from '../../config/public';
export function getStaticPaths() { return locales.flatMap(lang => ['about', 'privacy', 'feedback'].map(page => ({ params: { lang, page } }))); }
const lang = Astro.params.lang as Locale; const page = Astro.params.page as 'about' | 'privacy' | 'feedback'; const c = copy[lang];
const config = readPublicConfig({ SITE_URL: import.meta.env.SITE_URL, ADMIN_URL: import.meta.env.ADMIN_URL, FEEDBACK_EMAIL: import.meta.env.FEEDBACK_EMAIL });
---
<Base title={c[page]} lang={lang} path={`${page}/`}><div class="page-head"><div class="eyebrow">CREATIVE / {c[page]}</div><h1>{c[page]}</h1></div><article class="prose">
{page === 'about' && <><h2>{c.note}</h2><p>{c.intro}</p><p>{c.stageText}</p><p>{lang === 'zh' ? '我们从真实需求出发，逐步开发具体、实用的工具。目前没有已上线产品，也没有提供付费服务。' : 'We start with real needs and build focused, practical tools one at a time. There are currently no launched products or paid services.'}</p></>}
{page === 'privacy' && <><h2>{lang === 'zh' ? '当前的数据行为' : 'How this preview uses data'}</h2><p>{lang === 'zh' ? '公开页面不要求注册，不接收文件上传或付款，也没有反馈表单。页面不包含广告、第三方统计脚本或用于追踪的 Cookie。' : 'Public pages require no registration and accept no uploads or payments. There is no feedback form, advertising, third-party analytics, or tracking cookie.'}</p><p>{lang === 'zh' ? '浏览器会向提供页面的服务器发送必要的网络请求。托管服务可能记录 IP 地址、请求时间和路径等访问日志；正式公开部署前会补充实际托管方及日志保留说明。' : 'Your browser makes network requests to the server hosting these pages. The host may record access logs such as IP addresses, times, and paths. Hosting details and retention periods will be added before a public deployment.'}</p><h2>{lang === 'zh' ? '反馈与管理入口' : 'Feedback and administration'}</h2><p>{lang === 'zh' ? '若页面配置了反馈邮箱，发送邮件由你的邮件客户端完成，邮件内容会交给相应邮件服务处理。管理后台独立使用登录会话及安全 Cookie，仅供经营者使用。' : 'If a feedback email is configured, messages are sent through your email client and handled by the relevant email services. The separate administrator area uses login sessions and security cookies for the operator.'}</p></>}
{page === 'feedback' && <><h2>{lang === 'zh' ? '分享你遇到的问题' : 'Tell us about a problem'}</h2>{config.feedbackEmail ? <p><a href={`mailto:${encodeURIComponent(config.feedbackEmail)}`}>{config.feedbackEmail}</a></p> : <p>{lang === 'zh' ? '反馈渠道尚未配置。此页暂不收集或发送任何信息。' : 'A feedback channel has not been configured. This page does not collect or send any information.'}</p>}<p>{lang === 'zh' ? '后续可以通过异步方式分享具体问题，无需预约或沟通会议。' : 'Once a channel is available, you can share specific problems asynchronously, without booking a meeting.'}</p></>}
</article></Base>
