---
import Base from '../../layouts/Base.astro';
import EmptyCatalog from '../../components/EmptyCatalog.astro';
import { locales, copy, type Locale } from '../../lib/i18n';
import products from '../../data/products.json';
export function getStaticPaths() { return locales.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const c = copy[lang];
---
<Base title={c.tagline} lang={lang}>
  <section class="hero">
    <p class="eyebrow">CREATIVE TOOLS</p>
    <h1>{c.hero}</h1>
    <p class="lead">{c.intro}</p>
    <div class="hero-actions"><a class="button" href={`/${lang}/tools/`}>{c.catalog}<span aria-hidden="true">→</span></a><a class="text-link" href={`/${lang}/about/`}>{c.overview}</a></div>
  </section>
  <section class="directory-section" aria-labelledby="directory-title">
    <div class="section-heading"><h2 id="directory-title">{c.tools}</h2><span class="count">{products.length} {c.available}</span></div>
    <EmptyCatalog lang={lang} />
  </section>
  <section class="principles" aria-label={c.about}>
    <div><h2>{c.note}</h2><p>{c.detail}</p></div>
    <div><h2>{c.stage}</h2><p>{c.stageText}</p></div>
  </section>
</Base>
