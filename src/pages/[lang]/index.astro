---
import Base from '../../layouts/Base.astro';
import { locales, copy, type Locale } from '../../lib/i18n';
import products from '../../data/products.json';
export function getStaticPaths() { return locales.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale; const c = copy[lang];
---
<Base title={c.tagline} lang={lang}>
<section class="hero"><div class="eyebrow"><span class="dot"></span>CREATIVE / {c.status}</div><h1>{c.hero}</h1><p class="lead">{c.intro}</p><a class="button" href={`/${lang}/tools/`}>{c.catalog}<span aria-hidden="true">↗</span></a></section>
<section aria-labelledby="directory"><div class="section-heading"><h2 id="directory">{c.tools}</h2><span class="count">{String(products.length).padStart(2, '0')} / {lang === 'zh' ? '已上线' : 'AVAILABLE'}</span></div><div class="empty"><div class="empty-icon" aria-hidden="true">＋</div><div><h3>{c.empty}</h3><p>{c.preparing}</p></div><span class="pill">{c.status}</span></div></section>
<section class="notes"><div><span class="number">01 / {lang === 'zh' ? '我们的出发点' : 'OUR APPROACH'}</span><h2>{c.note}</h2><p>{c.detail}</p></div><div><span class="number">02 / {lang === 'zh' ? '保持真实' : 'KEEPING IT REAL'}</span><h2>{c.stage}</h2><p>{c.stageText}</p></div></section>
</Base>
