---
import Base from '../../../layouts/Base.astro';
import EmptyCatalog from '../../../components/EmptyCatalog.astro';
import { locales, copy, type Locale } from '../../../lib/i18n';
import products from '../../../data/products.json';
export function getStaticPaths() { return locales.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const c = copy[lang];
---
<Base title={c.tools} lang={lang} path="tools/" noindex>
  <section class="catalog-page">
    <div class="page-head"><h1>{c.tools}</h1><p>{c.directoryDescription}</p></div>
    <div class="catalog-summary"><span>{lang === 'zh' ? '全部工具' : 'All tools'}</span><span class="count">{products.length} {c.available}</span></div>
    <EmptyCatalog lang={lang} />
  </section>
</Base>
